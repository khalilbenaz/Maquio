{
  "name": "@calque/desktop",
  "version": "0.0.0",
  "private": true,
  "description": "Calque - editeur d'interfaces mobiles drag & drop",
  "author": "Calque",
  "type": "module",
  "main": "dist/main/main.js",
  "scripts": {
    "dev": "npm run build:electron && (vite &) && VITE_DEV_SERVER_URL=http://localhost:5173 electron .",
    "build:renderer": "vite build",
    "build:electron": "vite build --config vite.electron.main.config.ts && vite build --config vite.electron.preload.config.ts",
    "build": "npm run build:renderer && npm run build:electron",
    "start": "electron .",
    "dist": "npm run build && electron-builder --dir"
  },
  "build": {
    "appId": "com.calque.desktop",
    "productName": "Calque",
    "electronVersion": "44.4.3",
    "files": ["dist/**/*"],
    "directories": {
      "output": "release"
    }
  },
  "dependencies": {
    "@calque/ai": "*",
    "@calque/codegen": "*",
    "@calque/core": "*",
    "@calque/figma": "*",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^3.23.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3",
    "jsdom": "^29.1.1",
    "vite": "^8.3.0"
  }
}
